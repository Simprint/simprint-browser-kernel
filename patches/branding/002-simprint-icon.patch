diff --git a/build/config/chrome_build.gni b/build/config/chrome_build.gni
--- a/build/config/chrome_build.gni
+++ b/build/config/chrome_build.gni
@@ -76,6 +76,11 @@ assert(is_chrome_for_testing || !is_chrome_for_testing_branded,
 declare_args() {
   # Refers to the subdirectory for branding in various places including
   # chrome/app/theme.
   #
   # `branding_path_product` must not contain slashes.
+  # Simprint custom branding (icon, BRANDING file under chrome/app/theme/simprint/).
+  is_simprint_branded = false
+
   if (is_chrome_for_testing) {
     if (is_chrome_for_testing_branded) {
       branding_path_component = "google_chrome/google_chrome_for_testing"
@@ -86,6 +91,9 @@ declare_args() {
   } else if (is_internal_chrome_branded) {
     branding_path_component = "google_chrome"
     branding_path_product = "google_chrome"
+  } else if (is_simprint_branded) {
+    branding_path_component = "simprint"
+    branding_path_product = "simprint"
   } else {
     branding_path_component = "chromium"
     branding_path_product = "chromium"
diff --git a/build/BUILD.gn b/build/BUILD.gn
--- a/build/BUILD.gn
+++ b/build/BUILD.gn
@@ -48,6 +48,11 @@ buildflag_header("branding_buildflags") {
   } else {
     flags += [ "GOOGLE_CHROME_FOR_TESTING_BRANDING=false" ]
   }
 
+  if (is_simprint_branded) {
+    flags += [ "SIMPRINT_BRANDING=true" ]
+  } else {
+    flags += [ "SIMPRINT_BRANDING=false" ]
+  }
+
   flags += [ "ENABLE_BUILTIN_SEARCH_PROVIDER_ASSETS=$enable_builtin_search_provider_assets" ]
 }
