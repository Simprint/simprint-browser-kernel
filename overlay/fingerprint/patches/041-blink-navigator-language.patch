 void NavigatorLanguage::EnsureUpdatedLanguage() {
+  // Simprint: 检查是否有指纹配置的语言
+  std::string configured_language =
+      simprint::fingerprint::NetworkLocationFingerprint::GetConfiguredLanguage();
+  LOG(INFO) << "[Simprint Language] NavigatorLanguage::EnsureUpdatedLanguage - configured_language: " << configured_language;
+  if (!configured_language.empty()) {
+    languages_ = ParseAndSanitize(String::FromUTF8(configured_language));
+    languages_dirty_ = false;
+    LOG(INFO) << "[Simprint Language] NavigatorLanguage::EnsureUpdatedLanguage - set languages_ to: " << configured_language;
+    return;
+  }
+
   String accept_languages_override;
   probe::ApplyAcceptLanguageOverride(execution_context_,
                                      &accept_languages_override);
