 AtomicString DefaultLanguage() {
-  Vector<AtomicString>& override = PreferredLanguagesOverride();
-  if (!override.empty())
-    return override[0];
-  return PlatformLanguage();
+  // Simprint: 优先使用指纹配置的语言
+  std::string configured_language = simprint::config::GetLanguage();
+  LOG(INFO) << "[Simprint Language] DefaultLanguage - configured_language: " << configured_language;
+
+  if (!configured_language.empty()) {
+    AtomicString result = AtomicString(String::FromUTF8(configured_language));
+    LOG(INFO) << "[Simprint Language] DefaultLanguage returning configured: " << result;
+    return result;
+  }
+
+  // Simprint: 如果配置为空，等待配置加载，暂时返回 en-US 作为默认值
