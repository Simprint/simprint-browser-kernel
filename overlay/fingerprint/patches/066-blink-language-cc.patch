+  LOG(INFO) << "[Simprint Language] DefaultLanguage - config not loaded yet, returning default en-US";
+  return AtomicString("en-US");
 }
 
 Vector<AtomicString> UserPreferredLanguages() {
-  Vector<AtomicString>& override = PreferredLanguagesOverride();
-  if (!override.empty())
-    return override;
+  // Simprint: 优先使用指纹配置的语言
+  std::string configured_language = simprint::config::GetLanguage();
+  LOG(INFO) << "[Simprint Language] UserPreferredLanguages - configured_language: " << configured_language;
+
+  if (!configured_language.empty()) {
