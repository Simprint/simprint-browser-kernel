+    return languages;
+  }
 
+  // Simprint: 如果配置为空，等待配置加载，暂时返回 en-US 作为默认值
+  // 避免使用 PlatformLanguage() 因为它是静态缓存的系统语言
+  LOG(INFO) << "[Simprint Language] UserPreferredLanguages - config not loaded yet, returning default en-US";
   Vector<AtomicString> languages;
   languages.ReserveInitialCapacity(1);
-  languages.push_back(PlatformLanguage());
+  languages.push_back(AtomicString("en-US"));
   return languages;
 }
 
