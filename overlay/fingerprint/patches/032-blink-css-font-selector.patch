 #include "third_party/blink/renderer/platform/fonts/font_selector_client.h"
 #include "third_party/blink/renderer/platform/runtime_enabled_features.h"
 
+// Simprint
+#include "simprint/config/fingerprint_config_storage.h"
+#include "base/logging.h"
+#include <algorithm>
+#include <unordered_set>
+
 namespace blink {
 
 namespace {
@@ -170,6 +176,25 @@ const FontData* CSSFontSelector::GetFontData(
   const auto& family_name = font_family.FamilyName();
   Document& document = GetTreeScope()->GetDocument();
 
+  // Simprint: 字体白名单拦截 - 在字体选择阶段拦截
+  // 这里拦截所有字体请求，包括通过 DOM 元素渲染的字体
+  if (!font_family.FamilyIsGeneric()) {
+    std::string font_name = family_name.Utf8();
+    std::vector<std::string> font_list = simprint::config::GetFontList();
+
+    // 检查字体是否在白名单中
+    bool in_whitelist = std::find(font_list.begin(), font_list.end(), font_name) != font_list.end();
+
+    if (!in_whitelist && !font_list.empty()) {
+      // 字体不在白名单中，返回 nullptr 强制使用 fallback 字体
+      LOG(INFO) << "[Simprint Font] GetFontData() blocked: " << font_name
+                << " (will fallback to generic font)";
+      return nullptr;
+    }
+
+    LOG(INFO) << "[Simprint Font] GetFontData() allowed: " << font_name;
+  }
+
   FontDescription request_description(font_description);
   const FontPalette* request_palette = request_description.GetFontPalette();
 
