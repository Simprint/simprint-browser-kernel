+            std::string hex_str = configured_mac.substr(pos, 2);
+            int val = 0;
+            if (base::HexStringToInt(hex_str, &val) && val >= 0 && val <= 255) {
+              new_mac[i] = static_cast<uint8_t>(val);
+            } else {
+              valid = false;
+              break;
+            }
+          }
+        }
+        if (valid) {
+          mac_address = new_mac;
+        }
+      }
+    }
