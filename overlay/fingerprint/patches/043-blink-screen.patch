 int Screen::height() const {
+  // Simprint: 应用屏幕高度指纹
+  int configured_height = simprint::fingerprint::ScreenHardwareFingerprint::GetConfiguredScreenHeight();
+  if (configured_height > 0) {
+    return configured_height;
+  }
+
   if (!DomWindow())
     return 0;
   return GetRect(/*available=*/false).height();
 }
 
