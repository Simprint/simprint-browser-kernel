 #include "third_party/blink/renderer/core/timing/performance.h"
 #include "third_party/blink/renderer/modules/speech/speech_synthesis_error_event.h"
@@ -95,6 +96,22 @@ void SpeechSynthesis::OnSetVoiceList(
 const HeapVector<Member<SpeechSynthesisVoice>>& SpeechSynthesis::getVoices() {
   // Kick off initialization here to ensure voice list gets populated.
   std::ignore = TryEnsureMojomSynthesis();
+
+  // 指纹拦截：检查是否需要过滤语音列表
+  std::string speech_mode = simprint::fingerprint::BrowserFingerprint::GetConfiguredSpeechVoicesMode();
+  if (speech_mode == "noise" && !voice_list_.empty()) {
+    // 限制返回的语音数量（例如只返回前3个）
+    static HeapVector<Member<SpeechSynthesisVoice>> filtered_voices;
+    if (filtered_voices.empty() && voice_list_.size() > 3) {
+      for (wtf_size_t i = 0; i < 3; i++) {
+        filtered_voices.push_back(voice_list_[i]);
+      }
+    }
+    if (!filtered_voices.empty()) {
+      return filtered_voices;
+    }
+  }
+
   return voice_list_;
 }
 
