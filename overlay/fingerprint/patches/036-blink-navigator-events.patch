 int32_t NavigatorEvents::maxTouchPoints(Navigator& navigator) {
+  // Simprint: 应用最大触摸点数指纹
+  int configured_touch_points = simprint::fingerprint::ScreenHardwareFingerprint::GetConfiguredMaxTouchPoints();
+  if (configured_touch_points >= 0) {
+    return configured_touch_points;
+  }
+
   LocalDOMWindow* window = navigator.DomWindow();
   return window ? window->GetFrame()->GetSettings()->GetMaxTouchPoints() : 0;
 }
