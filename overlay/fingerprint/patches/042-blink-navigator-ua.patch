@@ -16,6 +19,45 @@ NavigatorUAData* NavigatorUA::userAgentData() {
       MakeGarbageCollected<NavigatorUAData>(GetUAExecutionContext());
 
   UserAgentMetadata metadata = GetUserAgentMetadata();
+
+  // Simprint: 检查是否有配置的 UserAgent，如果有则修改 metadata
+  std::string configured_ua = simprint::config::GetUserAgent();
+
+  if (!configured_ua.empty()) {
+    // Simprint: 使用原始完整版本号（而非从简化后的 UA 提取）
+    // 这样可以实现：JavaScript UA 显示 144.0.0.0，Client Hints 显示 144.0.6477.96
+    std::string original_version = simprint::config::GetOriginalChromeVersion();
+
+    if (!original_version.empty()) {
+      // 从原始版本号提取主版本号
+      size_t dot_pos = original_version.find('.');
+      std::string major_version = (dot_pos != std::string::npos)
+          ? original_version.substr(0, dot_pos)
+          : original_version;
+
+      // 修改 brand_version_list (低熵值 - 只显示主版本号)
+      metadata.brand_version_list.clear();
+      metadata.brand_version_list.push_back({"Chromium", major_version});
+      metadata.brand_version_list.push_back({"Google Chrome", major_version});
+      metadata.brand_version_list.push_back({"Not:A-Brand", "99"});
+
+      // 修改 brand_full_version_list (高熵值 - 显示完整版本号)
+      metadata.brand_full_version_list.clear();
+      metadata.brand_full_version_list.push_back({"Chromium", original_version});
+      metadata.brand_full_version_list.push_back({"Google Chrome", original_version});
+      metadata.brand_full_version_list.push_back({"Not:A-Brand", "99.0.0.0"});
+
+      // 修改完整版本号
+      metadata.full_version = original_version;
+    }
+  }
+
+  // 检查是否有配置的 Platform
+  std::string configured_platform = simprint::config::GetPlatform();
+  if (!configured_platform.empty()) {
+    metadata.platform = configured_platform;
+  }
+
   ua_data->SetBrandVersionList(metadata.brand_version_list);
   ua_data->SetMobile(metadata.mobile);
   ua_data->SetPlatform(String::FromUTF8(metadata.platform),
