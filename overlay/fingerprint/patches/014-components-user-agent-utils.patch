+    int major_version = simprint::config::GetChromeMajorVersionFromUserAgent();
+    std::string full_version = simprint::config::GetChromeVersionFromUserAgent();
+    if (major_version > 0 && !full_version.empty()) {
+      return GetUserAgentBrandList(base::NumberToString(major_version), full_version,
+                                   blink::UserAgentBrandVersionType::kFullVersion,
+                                   additional_brand_version);
+    }
+  }
