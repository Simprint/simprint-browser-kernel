+      // 从原始版本号提取主版本号
+      size_t dot_pos = original_version.find('.');
+      std::string major_version_str = (dot_pos != std::string::npos)
+          ? original_version.substr(0, dot_pos)
+          : original_version;
+
+      return GetUserAgentBrandList(major_version_str, original_version,
+                                   blink::UserAgentBrandVersionType::kFullVersion,
+                                   additional_brand_version);
+    }
+
