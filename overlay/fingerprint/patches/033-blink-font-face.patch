 ScriptPromise<FontFace> FontFace::load(ScriptState* script_state) {
+  // Simprint: 拦截字体检测
+  std::string font_name = family_.Utf8();
+  std::string font_list_mode = simprint::config::GetFontListMode();
+
+  if (!font_list_mode.empty() && font_list_mode != "system") {
+    std::vector<std::string> font_list = simprint::config::GetFontList();
+    bool is_in_list = std::find(font_list.begin(), font_list.end(), font_name) != font_list.end();
+
+    LOG(INFO) << "[Simprint Font] FontFace.load() called for: " << font_name
+              << ", mode=" << font_list_mode
+              << ", in_list=" << is_in_list;
+
+    // 如果字体不在白名单中，直接返回失败的 Promise
+    if (!is_in_list) {
+      SetError(MakeGarbageCollected<DOMException>(
+          DOMExceptionCode::kNetworkError,
+          "Failed to load font: not in configured font list"));
+      return FontStatusPromise(script_state);
+    }
+  }
+
   if (status_ == kUnloaded) {
     css_font_face_->Load();
   }
