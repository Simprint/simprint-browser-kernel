@@ -2049,6 +2050,25 @@ void RTCPeerConnectionHandler::OnIceCandidate(const String& sdp,
     return;
   }
   TRACE_EVENT0("webrtc", "RTCPeerConnectionHandler::OnIceCandidateImpl");
+
+  // Simprint: 检查是否需要过滤 ICE candidates
+  std::string webrtc_mode = simprint::fingerprint::NetworkLocationFingerprint::GetConfiguredWebRTCMode();
+  if (!webrtc_mode.empty() && webrtc_mode != "real") {
+    // 解析 SDP 以检查候选项类型
+    std::string sdp_str = sdp.Utf8();
+
+    if (webrtc_mode == "disable_non_proxied") {
+      // 只允许 relay 类型的候选项（通过 TURN 服务器）
+      if (sdp_str.find("typ relay") == std::string::npos) {
+        // 不是 relay 类型，丢弃此候选项
+        return;
+      }
+    } else if (webrtc_mode == "disable") {
+      // 完全禁用 ICE candidates
+      return;
+    }
+  }
+
   // This line can cause garbage collection.
   auto* platform_candidate = MakeGarbageCollected<RTCIceCandidatePlatform>(
       sdp, sdp_mid, sdp_mline_index, usernameFragment, url);
