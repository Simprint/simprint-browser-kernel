 String FrameLoader::UserAgent() const {
+  // Simprint: 优先使用指纹配置的 UserAgent
+  std::string configured_ua = simprint::fingerprint::NetworkLocationFingerprint::GetConfiguredUserAgent();
+  if (!configured_ua.empty()) {
+    LOG(INFO) << "FrameLoader::UserAgent() returning configured UA: " << configured_ua;
+    return String::FromUTF8(configured_ua);
+  }
+
+  LOG(INFO) << "FrameLoader::UserAgent() using default UA";
   return ApplyUserAgentOverride(Client()->UserAgent());
 }
 
