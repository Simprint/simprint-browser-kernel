+scoped_refptr<DrainableIOBuffer> SOCKS5ClientSocket::BuildAuthWriteBuffer()
+    const {
+  DCHECK(credentials_);
+
+  const std::string username = base::UTF16ToUTF8(credentials_->username());
+  const std::string password = base::UTF16ToUTF8(credentials_->password());
+  if (username.size() > 0xFF || password.size() > 0xFF) {
+    return nullptr;
+  }
+
+  std::vector<uint8_t> auth_request;
+  auth_request.reserve(3 + username.size() + password.size());
+  auth_request.push_back(0x01);
+  auth_request.push_back(base::checked_cast<uint8_t>(username.size()));
+  auth_request.insert(auth_request.end(), username.begin(), username.end());
+  auth_request.push_back(base::checked_cast<uint8_t>(password.size()));
+  auth_request.insert(auth_request.end(), password.begin(), password.end());
+
+  auto base_buffer =
+      base::MakeRefCounted<VectorIOBuffer>(std::move(auth_request));
+  return base::MakeRefCounted<DrainableIOBuffer>(std::move(base_buffer),
+                                                 base_buffer->size());
+}
+
+int SOCKS5ClientSocket::DoAuthWrite() {
+  next_state_ = STATE_AUTH_WRITE_COMPLETE;
+  if (!write_buf_) {
+    write_buf_ = BuildAuthWriteBuffer();
+    if (!write_buf_) {
+      LOG(ERROR) << "SOCKS5 credentials are too long for "
+                 << destination_.ToString();
+      return ERR_SOCKS_CONNECTION_FAILED;
+    }
+  }
+
+  return transport_socket_->Write(write_buf_.get(),
+                                  write_buf_->BytesRemaining(), io_callback_,
+                                  traffic_annotation_);
+}
+
+int SOCKS5ClientSocket::DoAuthWriteComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+
+  write_buf_->DidConsume(result);
+  if (write_buf_->BytesRemaining() == 0) {
+    write_buf_.reset();
+    next_state_ = STATE_AUTH_READ;
+  } else {
+    next_state_ = STATE_AUTH_WRITE;
+  }
+  return OK;
+}
+
+int SOCKS5ClientSocket::DoAuthRead() {
+  next_state_ = STATE_AUTH_READ_COMPLETE;
+  if (!read_buf_) {
+    read_buf_ = base::MakeRefCounted<GrowableIOBuffer>();
+    read_buf_->SetCapacity(2);
+  }
+  return transport_socket_->Read(read_buf_.get(),
+                                 read_buf_->RemainingCapacity(), io_callback_);
+}
+
+int SOCKS5ClientSocket::DoAuthReadComplete(int result) {
+  if (result < 0) {
+    return result;
+  }
+  if (result == 0) {
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+
+  read_buf_->set_offset(read_buf_->offset() + result);
+  if (read_buf_->RemainingCapacity() > 0) {
+    next_state_ = STATE_AUTH_READ;
+    return OK;
+  }
+
+  const base::span<uint8_t> read_data = read_buf_->span_before_offset();
+  if (read_data[0] != 0x01 || read_data[1] != 0x00) {
+    LOG(ERROR) << "SOCKS5 username/password auth rejected for "
+               << destination_.ToString() << ", version="
+               << static_cast<int>(read_data[0]) << ", status="
+               << static_cast<int>(read_data[1]);
+    return ERR_SOCKS_CONNECTION_FAILED;
+  }
+
+  read_buf_.reset();
+  next_state_ = STATE_HANDSHAKE_WRITE;
+  return OK;
+}
