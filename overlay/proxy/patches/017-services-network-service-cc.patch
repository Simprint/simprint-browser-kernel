+void NetworkService::SetSocks5AuthEntries(
+    std::vector<mojom::Socks5AuthEntryPtr> socks5_auth_entries) {
+  net::SOCKS5AuthCache::GetInstance().ClearCredentials();
+
+  for (const auto& entry : socks5_auth_entries) {
+    if (!entry || entry->host.empty() || entry->port == 0) {
+      continue;
+    }
+
+    net::SOCKS5AuthCache::GetInstance().SetCredentials(
+        net::HostPortPair(entry->host, entry->port),
+        net::AuthCredentials(base::UTF8ToUTF16(entry->username),
+                             base::UTF8ToUTF16(entry->password)));
+  }
+}
+
+void NetworkService::CloseAllConnections() {
+  for (NetworkContext* network_context : network_contexts_) {
+    network_context->CloseAllConnections(base::DoNothing());
+  }
+}
+
+void NetworkService::ClearHttpAuthCache() {
+  for (NetworkContext* network_context : network_contexts_) {
+    network_context->ClearHttpAuthCache(base::Time(), base::Time::Max(),
+                                        nullptr, base::DoNothing());
+  }
+}
