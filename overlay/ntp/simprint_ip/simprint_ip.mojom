module simprint_ip.mojom;

// IP information returned from the IP detection service.
struct IpInfo {
  string ip;           // The detected IP address
  string country;      // Country name (e.g., "United States")
  string country_code; // Country code (e.g., "US")
  string city;         // City name
  string region;       // Region/State name
  string isp;          // ISP name
  string timezone;     // Timezone
  bool success;        // Whether the detection was successful
  string error;        // Error message if detection failed
};

// Browser-side handler for IP detection requests from JS.
interface SimprintIpHandler {
  // Fetches the current public IP address and location info.
  GetIpInfo() => (IpInfo info);
};
