diff --git a/ui/views/controls/textfield/textfield.cc b/ui/views/controls/textfield/textfield.cc
index c0b7fb9eb0166..0b82d064f1e38 100644
--- a/ui/views/controls/textfield/textfield.cc
+++ b/ui/views/controls/textfield/textfield.cc
@@ -112,6 +112,14 @@
 #include "ui/views/touchui/touch_selection_controller_impl.h"
 #endif
 
+// Simprint: 全局回调指针声明（在全局命名空间中）
+using SyncTextCommitCallback = void (*)(uint8_t, const std::u16string&);
+extern SyncTextCommitCallback g_sync_text_commit_callback;
+
+// Simprint: 获取 Widget 的 root_index（由 chrome/ 层实现）
+using GetRootIndexForWidgetFunc = uint8_t (*)(void*);
+extern GetRootIndexForWidgetFunc g_get_root_index_for_widget_func;
+
 namespace views {
 namespace {
 
@@ -1704,6 +1712,15 @@ void Textfield::InsertText(const std::u16string& new_text,
     return;
   }
 
+  // Simprint: 同步 IME 输入的文本到从控（用于地址栏等 Views 控件）
+  if (!filtered_new_text.empty() && g_sync_text_commit_callback) {
+    uint8_t root_index = 0;
+    if (g_get_root_index_for_widget_func && GetWidget()) {
+      root_index = g_get_root_index_for_widget_func(GetWidget()->GetNativeView());
+    }
+    g_sync_text_commit_callback(root_index, filtered_new_text);
+  }
+
   // TODO(crbug.com/1155331): Handle |cursor_behavior| correctly.
   OnBeforeUserAction();
   skip_input_method_cancel_composition_ = true;
