# Branding 单元配置（仅定制项）
# deploy 阶段会将本配置同步到 Chromium 的 args.gn。

# 可执行文件名（对应补丁 001），生成 simprint.exe 等
chrome_executable_name = "simprint"

# 是否启用 Simprint 图标与 BRANDING（对应补丁 002、003）
is_simprint_branded = true

# 模板用：主题路径与图标名（如 theme/simprint/win、simprint.ico）
branding_path_component = "simprint"
# 模板用：产品显示名（BRANDING 等）
product_display_name = "Simprint"
