# Branding 单元配置（仅定制项）
# 复制为 branding.config 后按需修改。
# - apply 阶段：.patch.j2 模板用本配置渲染（branding_path_component、product_display_name 等）
# - deploy 阶段：deploy_resources.py 用本配置决定路径与文件名，不再硬编码
# - sync_gn_args：将 chrome_executable_name、is_simprint_branded 同步到 Chromium args.gn

# 可执行文件名（对应补丁 001），生成 simprint.exe 等
chrome_executable_name = "simprint"

# 是否启用自定义图标与 BRANDING（对应补丁 002、003）
is_simprint_branded = true

# 品牌路径组件：apply/deploy 共用。用于 theme/{branding_path_component}/、*_strings.grd、vector_icons/{branding_path_component}/、win 图标名（{branding_path_component}.ico 等）
branding_path_component = "simprint"
# 产品显示名（BRANDING、补丁模板、strings 占位符 __PRODUCT_DISPLAY_NAME__ 等）
product_display_name = "Simprint"

# 可选：通用图标目录名，相对 overlay/branding/icons，用于 theme product logo 等部署
icons_all_dir = "all"

# 可选：theme product logo 从 overlay 的映射。格式：Chromium 文件名:overlay 内文件名（在 icons/{icons_all_dir}/ 下），多个用逗号分隔。
# 用于设置栏、关于页、about:version、书签栏/菜单小图标等。未列出的仍从 chromium 复制。
# product_logo_32_2x.png 仅用于 default_200_percent 的 2x 图。product_logo_16/name_22/name_22_white 会写入 default_*_percent/simprint/。
theme_product_logo_overlay = "product_logo_32.png:32x32.png, product_logo_32_2x.png:128x128@2x.png, product_logo_64.png:128x128.png, product_logo_128.png:128x128.png, product_logo_256.png:128x128.png, product_logo_16.png:32x32.png, product_logo_name_22.png:32x32.png, product_logo_name_22_white.png:32x32-dark.png"

# 可选：标签页前默认小图标（灰色 chrome 图标）从 overlay 的映射。格式同上，目标为 ui/resources 的 default_favicon*.png。
# 亮色用 32x32.png，暗色用 32x32-dark.png；也可用 16x16-dark.png / 24x24-dark.png 等。
ui_default_favicon_overlay = "default_favicon.png:32x32.png, default_favicon_dark.png:32x32-dark.png, default_favicon_32.png:32x32.png, default_favicon_dark_32.png:32x32-dark.png, default_favicon_64.png:32x32.png, default_favicon_dark_64.png:32x32-dark.png"

# 可选：新标签页（chrome://newtab）在 tab 栏显示的图标。100% scale 用 16x16.png，200%/300% 用 32x32.png。
ntp_favicon_overlay = "32x32.png"
ntp_favicon_overlay_100 = "16x16.png"
