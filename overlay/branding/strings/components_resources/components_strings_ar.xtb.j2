<!DOCTYPE translationbundle>
<translationbundle lang="ar">
<translation id="130631256467250065">تسري التغييرات في المرة التالية التي تعيد فيها تشغيل الجهاز.</translation>
<translation id="261308610302996111">‏يُرجى الانتقال إلى
          قائمة ${ product_display_name } &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          والتأكّد من ضبط الإعدادات على "بلا خادم وكيل" أو "مباشر.".</translation>
<translation id="275588974610408078">‏تقارير الأعطال غير متاحة في ${ product_display_name }.</translation>
<translation id="3064346599913645280">‏أنت تعرض صفحة ${ product_display_name } آمنة</translation>
<translation id="3255926992597692024">‏يحاول ${ product_display_name } تعديل إعدادات ميزة "الملء التلقائي" لبيانات طُرق الدفع.</translation>
<translation id="358997566136285270">‏شعار ${ product_display_name }</translation>
<translation id="4050599136622776556">‏يحاول ${ product_display_name } تعديل طُرق الدفع.</translation>
<translation id="4365115785552740256">‏أصبح ${ product_display_name } الآن متاحًا بفضل المشروع المفتوح المصدر <ph name="BEGIN_LINK_CHROMIUM" />${ product_display_name }<ph name="END_LINK_CHROMIUM" /> و<ph name="BEGIN_LINK_OSS" />برامج أخرى مفتوحة المصدر<ph name="END_LINK_OSS" />.</translation>
<translation id="4622039161600275920">‏تم حظر هذه الصفحة بواسطة متصفّح ${ product_display_name }.</translation>
<translation id="48558539577516920">‏اسمح لـ ${ product_display_name } بالدخول إلى الشبكة من خلال إعدادات جدار الحماية أو
        برنامج مكافحة الفيروسات.</translation>
<translation id="4949828774841497663">‏يُرجى الانتقال إلى "التطبيقات" (Applications) &gt; "إعدادات النظام" (System Settings) &gt; "الشبكة" (Network)، ثم اختيار
          الشبكة النشطة، والنقر على زر "التفاصيل…" (Details…‎) وإلغاء اختيار أي خوادم وكيلة
          سبق اختيارها.</translation>
<translation id="6480456350195404966">‏يُرجى الانتقال إلى
          قائمة ${ product_display_name } &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          الشبكة والإنترنت &gt; الخادم الوكيل
          وإلغاء اختيار "رصد الإعدادات تلقائيًا".</translation>
<translation id="648062525172759633">‏هذه الصفحات مخصّصة لمطوّري ${ product_display_name }، وقد لا تتم صيانتها أو اختبارها بشكلٍ منتظم. لتفعيلها، يُرجى الانتقال إلى <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> والنقر على زر تفعيل صفحات تصحيح الأخطاء، ثم الانتقال إلى هذه الصفحة مرة أخرى.</translation>
<translation id="6549378540556750549">‏أصبح ${ product_display_name } متاحًا من خلال <ph name="BEGIN_LINK_OSS" />برنامج آخر مفتوح المصدر<ph name="END_LINK_OSS" />.</translation>
<translation id="6613594504749178791">‏ستسري التغييرات في المرة التالية التي تعيد فيها تشغيل ${ product_display_name }.</translation>
<translation id="691026815377248078">‏يجب منح ${ product_display_name } الإذن بالوصول إلى البلوتوث لمواصلة عملية 
الإقران. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">‏أصبح ${ product_display_name } متاحًا من خلال مشروع <ph name="BEGIN_LINK_CHROMIUM" />${ product_display_name }<ph name="END_LINK_CHROMIUM" /> المفتوح المصدر.</translation>
<translation id="7861509383340276692">‏انتقل إلى
        قائمة ${ product_display_name } &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        وألغ اختيار "<ph name="NO_PREFETCH_DESCRIPTION" />"
        في حالة ما إذا لم يؤد ذلك إلى حل المشكلة، نوصي بتحديد هذا الخيار
        مرة أخرى من أجل أداء أفضل.</translation>
<translation id="8597726643333341451">‏أنت تعرض صفحة Chrome for Testing آمنة.</translation>
<translation id="8684913864886094367">‏لم يغلق ${ product_display_name } بشكل صحيح.</translation>
</translationbundle>