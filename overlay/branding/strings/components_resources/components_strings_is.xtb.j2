<!DOCTYPE translationbundle>
<translationbundle lang="is">
<translation id="130631256467250065">Breytingarnar taka gildi næst þegar þú endurræsir tækið.</translation>
<translation id="261308610302996111">Farðu í
          valmynd ${ product_display_name } &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          og gakktu úr skugga um að stillt sé á „ekki proxy“ eða „beint“.</translation>
<translation id="275588974610408078">Hrunskýrslur eru ekki í boði í ${ product_display_name }.</translation>
<translation id="3064346599913645280">Þú ert að skoða örugga ${ product_display_name } síðu</translation>
<translation id="3255926992597692024">${ product_display_name } er að reyna að breyta stillingum fyrir útfyllingu greiðslumáta.</translation>
<translation id="358997566136285270">${ product_display_name } lógóið</translation>
<translation id="4050599136622776556">${ product_display_name } er að reyna að breyta greiðslumátum.</translation>
<translation id="4365115785552740256">Opna kóðaverkefnið <ph name="BEGIN_LINK_CHROMIUM" />${ product_display_name }<ph name="END_LINK_CHROMIUM" /> og annar <ph name="BEGIN_LINK_OSS" />opinn hugbúnaður<ph name="END_LINK_OSS" /> gerir ${ product_display_name } mögulegt.</translation>
<translation id="4622039161600275920">${ product_display_name } setti þessa síðu á bannlista</translation>
<translation id="48558539577516920">Veittu ${ product_display_name } aðgang að netkerfinu þínu í eldveggsstillingunum þínum eða
          vírusvarnarstillingunum.</translation>
<translation id="4949828774841497663">Farðu í Forrit &gt; Kerfisstillingar &gt; Netkerfi og veldu
          virkt netkerfi, smelltu á hnappinn Upplýsingar... og afveldu alla staðgengla
          sem kunna að hafa verið valdir.</translation>
<translation id="6480456350195404966">Farðu í
          valmynd ${ product_display_name }&gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Netkerfi og internet &gt; Proxy
          og afveldu „Greina stillingar sjálfkrafa“.</translation>
<translation id="648062525172759633">Þessar síður eru ætlaðar til notkunar hjá þróunaraðilum ${ product_display_name } og er e.t.v. ekki haldið við eða prófaðar reglulega. Til að kveikja á þeim skaltu fara á <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, smella á hnappinn til að kveikja á villuleitarsíðum og fara síðan aftur á þessa síðu.</translation>
<translation id="6549378540556750549">${ product_display_name } virkar einnig í krafti annars <ph name="BEGIN_LINK_OSS" />hugbúnaðar með opinn kóða<ph name="END_LINK_OSS" />.</translation>
<translation id="6613594504749178791">Breytingar þínar munu taka gildi næst þegar þú endurræsir ${ product_display_name }.</translation>
<translation id="691026815377248078">Google Chrome þarf Bluetooth-aðgang til að halda pörun 
 áfram. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">${ product_display_name } virkar í krafti verkefnis <ph name="BEGIN_LINK_CHROMIUM" />${ product_display_name }<ph name="END_LINK_CHROMIUM" /> um opinn kóða.</translation>
<translation id="7861509383340276692">Farðu í
        valmynd ${ product_display_name } &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        og taktu valið af „<ph name="NO_PREFETCH_DESCRIPTION" />“.
        Ef þetta leysir ekki málið mælum við með að gera þennan valkost
        virkan á ný til að auka afköst.</translation>
<translation id="8597726643333341451">Þú ert að skoða örugga Chrome for Testing-síðu</translation>
<translation id="8684913864886094367">${ product_display_name } lokaðist ekki á réttan hátt.</translation>
