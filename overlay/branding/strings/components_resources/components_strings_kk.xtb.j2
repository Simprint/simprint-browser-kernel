<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="130631256467250065">Өзгерістеріңіз құрылғыңызды келесі қайта іске қосқанда күшіне енеді.</translation>
<translation id="261308610302996111">"${ product_display_name } мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />"
          тармағына өтіп, конфигурация "прокси-серверсіз" немесе "тікелей" күйіне орнатылғанын тексеріңіз.</translation>
<translation id="275588974610408078">Бұзылу туралы хабарлау мүмкіндігі ${ product_display_name } қызметінде қолжетімді емес.</translation>
<translation id="3064346599913645280">Қауіпсіз ${ product_display_name } бетін көрудесіз</translation>
<translation id="3255926992597692024">${ product_display_name } төлеу әдістерін толтыру параметрлерін өзгерткісі келеді.</translation>
<translation id="358997566136285270">${ product_display_name } логотипі</translation>
<translation id="4050599136622776556">${ product_display_name } төлеу әдістерін өзгерткісі келеді.</translation>
<translation id="4365115785552740256">${ product_display_name } қолданбасына <ph name="BEGIN_LINK_CHROMIUM" />${ product_display_name }<ph name="END_LINK_CHROMIUM" /> ашық бастапқы код жобасы мен басқа <ph name="BEGIN_LINK_OSS" />ашық бастапқы код бағдарламалық жасақтамасы<ph name="END_LINK_OSS" /> арқылы қол жеткізілді.</translation>
<translation id="4622039161600275920">Бұл бетке ${ product_display_name } тарапынан тыйым салынған.</translation>
<translation id="48558539577516920">Брандмауэр немесе антивирус параметрлерінде ${ product_display_name } жүйесіне
          желіге кіруге рұқсат беріңіз.</translation>
<translation id="4949828774841497663">"Қолданбалар &gt; Жүйе параметрлері &gt; Желі" тармағына өтіп, белсенді желіні таңдаңыз да, "Мәліметтер..." түймесін басып, бұрын таңдалған прокси-серверлерді таңдаудан алыңыз.</translation>
<translation id="6480456350195404966">"${ product_display_name } мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Желі және интернет &gt; Прокси-сервер"
          тармағына өтіп, "Параметрлерді автоматты түрде анықтау" опциясын таңдаудан алыңыз.</translation>
<translation id="648062525172759633">Бұл беттер ${ product_display_name } әзірлеушілерінің қолданысына арналған және белсенді түрде жүргізілмеуі не сыналмауы мүмкін. Оларды қосу үшін <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" /> сайтына өтіп, түзету беттерін қосатын түймені басып, осы бетке қайтып келіңіз.</translation>
<translation id="6549378540556750549">Сонымен қатар ${ product_display_name } басқа <ph name="BEGIN_LINK_OSS" />ашық кодты бағдарламалық құрал<ph name="END_LINK_OSS" /> арқылы қолжетімді болады.</translation>
<translation id="6613594504749178791">Өзгертулеріңіз ${ product_display_name } келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="691026815377248078">Жұптауды жалғастыру үшін ${ product_display_name }-ге Bluetooth-ты пайдалану рұқсаты керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">${ product_display_name } браузері <ph name="BEGIN_LINK_CHROMIUM" />${ product_display_name }<ph name="END_LINK_CHROMIUM" /> ашық кодты бағдарлама жобасы арқылы қолжетімді болады.</translation>
<translation id="7861509383340276692">${ product_display_name } мәзірі &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          тармағына өтіп, "<ph name="NO_PREFETCH_DESCRIPTION" />" таңдауын алып тастаңыз.
          Бұл мәселені шешпесе, өнімділікті жақсарту үшін осы опцияны қайта
          таңдауды ұсынамыз.</translation>
<translation id="8597726643333341451">Қауіпсіз Chrome for Testing бетін көріп отырсыз.</translation>
<translation id="8684913864886094367">${ product_display_name } дұрыс өшірілмеді.</translation>
