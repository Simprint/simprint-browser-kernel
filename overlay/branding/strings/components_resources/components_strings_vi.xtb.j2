<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="130631256467250065">Thay đổi của bạn sẽ có hiệu lực vào lần tiếp theo bạn khởi động lại thiết bị của mình.</translation>
<translation id="261308610302996111">Chuyển đến
          trình đơn ${ product_display_name } &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          và đảm bảo cấu hình của bạn được đặt thành "không có proxy" hoặc "trực tiếp".</translation>
<translation id="275588974610408078">Báo cáo sự cố hiện không khả dụng trong ${ product_display_name }.</translation>
<translation id="3064346599913645280">Bạn đang xem trang ${ product_display_name } an toàn</translation>
<translation id="3255926992597692024">${ product_display_name } đang cố gắng sửa đổi chế độ cài đặt cho việc điền phương thức thanh toán.</translation>
<translation id="358997566136285270">Biểu trưng ${ product_display_name }</translation>
<translation id="4050599136622776556">${ product_display_name } đang cố gắng chỉnh sửa phương thức thanh toán.</translation>
<translation id="4365115785552740256">${ product_display_name } trở nên khả thi là nhờ dự án nguồn mở <ph name="BEGIN_LINK_CHROMIUM" />${ product_display_name }<ph name="END_LINK_CHROMIUM" /> và các <ph name="BEGIN_LINK_OSS" />phần mềm nguồn mở<ph name="END_LINK_OSS" /> khác.</translation>
<translation id="4622039161600275920">Trang này bị ${ product_display_name } chặn</translation>
<translation id="48558539577516920">Cho phép ${ product_display_name } truy cập mạng trong cài đặt tường lửa hoặc diệt vi-rút 
        của bạn.</translation>
<translation id="4949828774841497663">Chuyển đến phần Ứng dụng &gt; Cài đặt hệ thống &gt; Mạng, chọn
          mạng đang hoạt động, nhấp vào nút Chi tiết..., rồi bỏ chọn mọi máy chủ proxy
          có thể đã được chọn.</translation>
<translation id="6480456350195404966">Chuyển đến
          trình đơn ${ product_display_name } &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="SYSTEM_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          Mạng và Internet &gt; Proxy
          rồi bỏ chọn "Tự động phát hiện chế độ cài đặt".</translation>
<translation id="648062525172759633">Các trang này dành cho nhà phát triển ${ product_display_name } sử dụng và có thể không được duy trì hoặc kiểm tra liên tục. Để kích hoạt các trang này, hãy chuyển đến <ph name="BEGIN_LINK" />chrome://chrome-urls<ph name="LINK_END" />, nhấp vào nút để kích hoạt trang gỡ lỗi, rồi chuyển đến trang này một lần nữa.</translation>
<translation id="6549378540556750549">${ product_display_name } cũng được cung cấp thông qua <ph name="BEGIN_LINK_OSS" />phần mềm nguồn mở<ph name="END_LINK_OSS" /> khác.</translation>
<translation id="6613594504749178791">Các thay đổi của bạn sẽ có hiệu lực vào lần tới khi bạn chạy lại ${ product_display_name }.</translation>
<translation id="691026815377248078">${ product_display_name } cần có quyền truy cập Bluetooth để tiếp tục 
 ghép nối. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="7681937895330411637">${ product_display_name } được cung cấp thông qua dự án nguồn mở <ph name="BEGIN_LINK_CHROMIUM" />${ product_display_name }<ph name="END_LINK_CHROMIUM" />.</translation>
<translation id="7861509383340276692">Chuyển đến
          menu ${ product_display_name } &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          và bỏ chọn "<ph name="NO_PREFETCH_DESCRIPTION" />."
          Nếu cách này không giải quyết được sự cố thì chúng tôi khuyên bạn nên chọn lại tùy chọn này
          để cải thiện hiệu suất.</translation>
<translation id="8597726643333341451">Bạn đang xem một trang Chrome for Testing an toàn</translation>
<translation id="8684913864886094367">${ product_display_name } không tắt đúng cách.</translation>
</translationbundle>