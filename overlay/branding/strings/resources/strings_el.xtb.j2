<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1026101648481255140">Συνέχιση εγκατάστασης</translation>
<translation id="1029669172902658969">Επανεκκίνηση για ενημέρωση του &amp;${ product_display_name } OS</translation>
<translation id="1040916596585577953">Το ${ product_display_name } συνιστά να ελέγξετε αυτή την επέκταση</translation>
<translation id="1042552502243217427">Όταν ένας ιστότοπος ζητά την ιδιωτική προφόρτωση συνδέσμων στη σελίδα του, το ${ product_display_name } χρησιμοποιεί τους διακομιστές της Google. Με αυτόν τον τρόπο, η ταυτότητά σας αποκρύπτεται από τον προφορτωμένο ιστότοπο, αλλά η Google μαθαίνει ποιοι ιστότοποι προφορτώνονται.</translation>
<translation id="1051793555070215510">Βοηθήστε μας να βελτιώσουμε την ανώνυμη περιήγηση, συμμετέχοντας σε αυτή την έρευνα διάρκειας 1 λεπτού.</translation>
<translation id="1065672644894730302">Δεν είναι δυνατή η ανάγνωση των προτιμήσεών σας. Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες και οι αλλαγές στις προτιμήσεις δεν θα αποθηκευτούν.</translation>
<translation id="1083934481477628225">Ο γονέας σου απενεργοποίησε την επιλογή "Άδειες για ιστοτόπους, εφαρμογές και επεκτάσεις" για το ${ product_display_name }</translation>
<translation id="1104942323762546749">Το ${ product_display_name } θέλει να εξαγάγει τους κωδικούς πρόσβασής σας. Για να το επιτρέψετε αυτό, πληκτρολογήστε τον κωδικό πρόσβασης για τα Windows.</translation>
<translation id="112640046208448578">Αναγνωρίστε αντικείμενα ή μέρη και αντιγράψτε ή μεταφράστε κείμενο. Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ένα στιγμιότυπο οθόνης της σελίδας αποστέλλεται στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="113122355610423240">Το ${ product_display_name } είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="1131805035311359397">Για να ελέγξετε αν οι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK" />συνδεθείτε στο ${ product_display_name }<ph name="END_LINK" />.</translation>
<translation id="1153368717515616349">Κάντε κλικ στο μενού του ${ product_display_name }</translation>
<translation id="1157985233335035034">Πρόσφατες γλώσσες</translation>
<translation id="1171831736360285680">Ο συνεργάτης <ph name="PARTNER_NAME" /> πρόσθεσε μια επέκταση που ενδέχεται να αλλάξει τον τρόπο λειτουργίας του ${ product_display_name }.

<ph name="EXTENSION_NAME" /></translation>
<translation id="1184145431117212167">Η εγκατάσταση απέτυχε επειδή η έκδοση των Windows που χρησιμοποιείτε δεν υποστηρίζεται.</translation>
<translation id="1185134272377778587">Σχετικά με το ${ product_display_name }</translation>
<translation id="1203500561924088507">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε το πρόγραμμα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME" />.</translation>
<translation id="1232234696885483911">Όταν ανοίγετε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, θα αποστέλλονται αυτόματα στον διακομιστή. <ph name="LEARN_MORE" /></translation>
<translation id="123265588161106468">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Google στο ${ product_display_name }. Για να αλλάξετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα Ο λογαριασμός σας στο ${ product_display_name }.</translation>
<translation id="1262876892872089030">Ενώ αυτή η καρτέλα ήταν ανενεργή, ελευθερώθηκε μνήμη για να παραμείνει γρήγορο το ${ product_display_name }. Μπορείτε να επιλέξετε να εξαιρείται πάντα αυτός ο ιστότοπος, ώστε να παραμένει ενεργός.</translation>
<translation id="1265577313130862557">Το ${ product_display_name } απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι επικίνδυνο</translation>
<translation id="126567311906253476">Όταν συνδέεστε σε υπηρεσίες Google, όπως το Gmail ή το YouTube, με τον λογαριασμό <ph name="USER_EMAIL" />, μπορείτε να συνδέεστε αυτόματα στο ${ product_display_name } με τον ίδιο λογαριασμό</translation>
<translation id="1290883685122687410">Σφάλμα ρύθμισης: <ph name="METAINSTALLER_EXIT_CODE" />. <ph name="WINDOWS_ERROR" /></translation>
<translation id="1315551408014407711">Ρυθμίστε το νέο σας προφίλ στο ${ product_display_name }</translation>
<translation id="1324107359134968521">Το ${ product_display_name } χρειάζεται πρόσβαση στο Bluetooth για εξερεύνηση 
 Συσκευών Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1330562121671411446">Εντοπισμός γλώσσας</translation>
<translation id="1342274909142618978">Να διαγραφούν επίσης δεδομένα από το ${ product_display_name } (<ph name="URL" />)</translation>
<translation id="1345251407431278948">Καρφιτσώθηκε! Μπορείτε να αποκτήσετε ξανά πρόσβαση στην Αναζήτηση με εικόνες από το νέο κουμπί στη γραμμή εργαλείων</translation>
<translation id="1356661055722410047">Νέο! Μπορείτε να μεταφράσετε κείμενο και εικόνες που εμφανίζονται στην οθόνη σας</translation>
<translation id="1383876407941801731">Αναζήτηση</translation>
<translation id="1397530502368084401">&amp;Διαχείριση προφίλ ${ product_display_name }</translation>
<translation id="141901961143729572">Μοιραστείτε τις σκέψεις σας</translation>
<translation id="1465192221147974788">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το ${ product_display_name } στις Ρυθμίσεις συστήματος.</translation>
<translation id="1478370723027452770">Λήψη βοήθειας για το Chrome for Testing</translation>
<translation id="1497802159252041924">Σφάλμα εγκατάστασης: <ph name="INSTALL_ERROR" /></translation>
<translation id="1518627427551567882">Αυτή η σελίδα είναι προστατευμένη</translation>
<translation id="1524282610922162960">Μοιραστείτε μια καρτέλα του ${ product_display_name }</translation>
<translation id="154404805518949443">Σύνδεση στο ${ product_display_name }</translation>
<translation id="1547469039832541117">Τερματίζει την επισημασμένη εργασία.</translation>
<translation id="1553461853655228091">Το ${ product_display_name } χρειάζεται άδεια πρόσβασης στην κάμερά σας, για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="1555494096857516577">{NUM_EXTENSIONS,plural, =1{Αυτή η επέκταση δεν υποστηρίζεται πλέον. Το ${ product_display_name } συνιστά να την καταργήσετε.}other{Αυτές οι επεκτάσεις δεν υποστηρίζονται πλέον. Το ${ product_display_name } συνιστά να τις καταργήσετε.}}</translation>
<translation id="1562320819937089394">Καρφίτσωμα ${ product_display_name }</translation>
<translation id="1574377791422810894">Εργαλεία ασφάλειας του ${ product_display_name }</translation>
<translation id="1594928384848033697">Το ${ product_display_name } θέλει να διαγράψει τα δεδομένα της Διαχείρισης κωδικών πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το ${ product_display_name }, προκειμένου να εφαρμοστεί μια ενημέρωση.}=1{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το ${ product_display_name }, προκειμένου να εφαρμοστεί μια ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το ${ product_display_name }, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="1625909126243026060">Ελέγξτε σημαντικά στοιχεία ελέγχου για το απόρρητο και την ασφάλεια στο ${ product_display_name }</translation>
<translation id="1640672724030957280">Γίνεται λήψη…</translation>
<translation id="1680687534629375545">Ερώτηση στην Αναζήτηση με εικόνες σχετικά με αυτή τη σελίδα</translation>
<translation id="1709772298389099340">Παρέχει αναβαθμισμένα προνόμια για το <ph name="BROWSER_NAME" />.</translation>
<translation id="1715127912119967311">Στο πλαίσιο της βελτίωσης αυτών των λειτουργιών, το ${ product_display_name } στέλνει στην Google τις αλληλεπιδράσεις σας με τις λειτουργίες. Αυτά τα δεδομένα ενδέχεται να αναγνωστούν, να υποβληθούν σε επεξεργασία και να σχολιαστούν από αναθεωρητές.</translation>
<translation id="1722488837206509557">Αυτό θα σας επιτρέψει να επιλέγετε μία από τις διαθέσιμες συσκευές και να προβάλλετε περιεχόμενο σε αυτήν.</translation>
<translation id="1733725117201708356">Το ${ product_display_name } θα διαγράψει σύντομα τα δεδομένα περιήγησης</translation>
<translation id="1736443181683099871">Το ${ product_display_name } θα προσπαθήσει να αναβαθμίσει τις πλοηγήσεις σε HTTPS</translation>
<translation id="1736662517232558588">Διαγρ. δεδ. ${ product_display_name }</translation>
<translation id="1745121272106313518">Θα γίνει επανεκκίνηση του ${ product_display_name } σε <ph name="REMAINING_TIME" /></translation>
<translation id="1749104137266986751">Όταν δεν είναι διαθέσιμο το HTTPS, το ${ product_display_name } θα χρησιμοποιεί μια μη ασφαλή σύνδεση χωρίς να σας ειδοποιεί</translation>
<translation id="1774152462503052664">Να επιτρέπεται στο ${ product_display_name } να εκτελείται στο παρασκήνιο</translation>
<translation id="1779356040007214683">Για να κάνουμε το ${ product_display_name } πιο ασφαλές, απενεργοποιήσαμε ορισμένες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="1808667845054772817">Επανεγκατάσταση του ${ product_display_name }</translation>
<translation id="1820835682567584003">Το ${ product_display_name } προσπαθεί να <ph name="AUTHENTICATION_PURPOSE" /></translation>
<translation id="183031085822326697">Την επόμενη φορά που θα ανοίξετε το ${ product_display_name } στη συσκευή <ph name="DEVICE_TYPE" />, θα δείτε μια προτροπή για χρήση της Διαχείρισης κωδικών πρόσβασης Google.</translation>
<translation id="1838374766361614909">Διαγραφή αναζητήσεων</translation>
<translation id="18552579716432081">Για να διαγράψετε τα δεδομένα περιήγησης μόνο από αυτή τη συσκευή και να τα διατηρήσετε στον Λογαριασμό σας Google, <ph name="BEGIN_LINK" />αποσυνδεθείτε από το ${ product_display_name }<ph name="END_LINK" />.</translation>
<translation id="1857749206890802997">Κατεβάστε το ${ product_display_name } στο τηλέφωνό σας για άνοιγμα ή δημιουργία νέων ομάδων καρτελών εν κινήσει.</translation>
<translation id="185970820835152459">Μπορείτε να διαχειριστείτε τους συνδεδεμένους Λογαριασμούς σας Google. Οι Λογαριασμοί σας Google χρησιμοποιούνται για το πρόγραμμα περιήγησης ${ product_display_name }, το Play Store, το Gmail κ.ά. Εάν θέλετε να προσθέσετε έναν λογαριασμό για κάποιο άλλο άτομο, όπως για ένα μέλος της οικογένειας, προσθέστε, αντ' αυτού, ένα νέο άτομο στη συσκευή σας <ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />Μάθετε περισσότερα<ph name="LINK_END" /></translation>
<translation id="1862852878885210965">Αναζητήστε με την Αναζήτηση με εικόνες</translation>
<translation id="1880677175115548835">Επιλογή κειμένου</translation>
<translation id="1881322772814446296">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο ${ product_display_name }. Τα δεδομένα σας στο ${ product_display_name }, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME" />. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Google, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. Αν θέλετε, μπορείτε να δημιουργήσετε ένα νέο προφίλ στο οποίο θα διατηρηθούν ξεχωριστά τα υπάρχοντα δεδομένα του ${ product_display_name }. <ph name="LEARN_MORE" /></translation>
<translation id="1896836275755235458">Το ${ product_display_name } εξοικονομεί μπαταρία περιορίζοντας τη δραστηριότητα στο παρασκήνιο και τα οπτικά εφέ, όπως είναι η ομαλή κύλιση και οι ρυθμοί καρέ βίντεο. <ph name="BEGIN_LINK" />Μάθετε περισσότερα σχετικά με την Εξοικονόμηση ενέργειας<ph name="END_LINK" /></translation>
<translation id="1898804291554630487">Ρωτήστε σχετικά με αυτή τη σελίδα</translation>
<translation id="1900969832270057921">Υπηρεσία ${ product_display_name } Updater</translation>
<translation id="1911763535808217981">Με την απενεργοποίηση αυτής της λειτουργίας, μπορείτε να συνδεθείτε σε ιστοτόπους Google, όπως το Gmail, χωρίς να συνδεθείτε στο ${ product_display_name }</translation>
<translation id="1929939181775079593">Το ${ product_display_name } δεν ανταποκρίνεται. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="1933341829955786215">Ο οργανισμός σας, <ph name="MANAGER" />, απαιτεί να συνδεθείτε στο ${ product_display_name }</translation>
<translation id="193439633299369377">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του ${ product_display_name } OS.</translation>
<translation id="1951406923938785464">Το ${ product_display_name } απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του τύπου αρχείου και ενδέχεται να είναι επικίνδυνος</translation>
<translation id="1953553007165777902">Λήψη… Απομένουν <ph name="MINUTE" /> λεπτά</translation>
<translation id="1965068424387304464">Συμβουλή για το ${ product_display_name }: Αποθήκευση κωδικών πρόσβασης</translation>
<translation id="1966382378801805537">Το ${ product_display_name } δεν μπορεί να καθορίσει ή να ορίσει το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="1990262977744080398">Μάθετε γιατί το ${ product_display_name } αποκλείει ορισμένα αρχεία, ανοίγει σε νέα καρτέλα</translation>
<translation id="1999715455684970349">Διατηρεί το λογισμικό ${ product_display_name } ενημερωμένο. Εάν αυτή η υπηρεσία απενεργοποιηθεί ή σταματήσει, το λογισμικό ${ product_display_name } δεν θα ενημερώνεται, πράγμα που σημαίνει ότι δεν θα είναι δυνατή η επιδιόρθωση ευπαθειών ασφάλειας που μπορεί να εμφανιστούν και μπορεί να μη λειτουργούν ορισμένα χαρακτηριστικά. Η εγκατάσταση της υπηρεσίας αυτής καταργείται αυτόματα, όταν δεν υπάρχει λογισμικό ${ product_display_name } που να τη χρησιμοποιεί.</translation>
<translation id="2008474315282236005">Με αυτή την ενέργεια θα διαγραφεί 1 στοιχείο από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο ${ product_display_name } ως <ph name="USER_EMAIL" />.</translation>
<translation id="2018879682492276940">Αποτυχία εγκατάστασης. Δοκιμάστε ξανά.</translation>
<translation id="2020032459870799438">Για να ελέγξετε αν οι άλλοι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK" />συνδεθείτε στο ${ product_display_name }<ph name="END_LINK" />.</translation>
<translation id="2039417478970545937">Ρυθμίσεις.</translation>
<translation id="2049376729098081731">Επιλέξτε αν θέλετε να συμπεριλαμβάνεται το ιστορικό ${ product_display_name } για πιο εξατομικευμένες εμπειρίες στις υπηρεσίες Google.</translation>
<translation id="2064856577282482477">Κάντε κλικ στο κουμπί Προσαρμογή ${ product_display_name } στη σελίδα Νέα καρτέλα, για να δώσετε μια νέα εμφάνιση στο ${ product_display_name }</translation>
<translation id="2086476982681781442">Το ${ product_display_name } απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι παραπλανητικό και μπορεί να κάνει μη αναμενόμενες αλλαγές στη συσκευή σας</translation>
<translation id="208726765006323911">Την επόμενη φορά που θα ανοίξετε το ${ product_display_name } iOS, θα δείτε μια προτροπή για να δοκιμάσετε τη λειτουργία <ph name="FEATURE_NAME" />.</translation>
<translation id="2099452623287920103">Οι κωδικοί πρόσβασης και άλλα δεδομένα του ${ product_display_name } που αποθηκεύσατε στον Λογαριασμό σας Google θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο ${ product_display_name }, συνδεθείτε ξανά.</translation>
<translation id="2120965832000301375">{COUNT,plural, =1{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το ${ product_display_name } δεν χρησιμοποιείται για 1 λεπτό. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}other{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το ${ product_display_name } δεν χρησιμοποιείται για # λεπτά. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}}</translation>
<translation id="2126108037660393668">Η επιβεβαίωση του ληφθέντος αρχείου απέτυχε.</translation>
<translation id="2137162749895930932">Κλείσιμο οθόνης μετάφρασης</translation>
<translation id="215352261310130060">Το ${ product_display_name } απέκλεισε αυτή τη λήψη επειδή ο ιστότοπος δεν χρησιμοποιεί ασφαλή σύνδεση και το αρχείο μπορεί να έχει παραβιαστεί</translation>
<translation id="2174178932569897599">Προσαρμογή του ${ product_display_name }</translation>
<translation id="2174917724755363426">Η εγκατάσταση δεν έχει ολοκληρωθεί. Είστε βέβαιοι ότι θέλετε να την ακυρώσετε;</translation>
<translation id="2185166961232948079">${ product_display_name } - Σύνδεση δικτύου - <ph name="PAGE_TITLE" /></translation>
<translation id="2190166659037789668">Σφάλμα ελέγχου για ενημερώσεις: <ph name="UPDATE_CHECK_ERROR" />.</translation>
<translation id="2199210295479376551">Κατάργηση λογαριασμού από το ${ product_display_name }</translation>
<translation id="2210502920229141283">Παραμείνετε ασφαλείς εν κινήσει με τη Βελτιωμένη Ασφαλή περιήγηση στο ${ product_display_name } για iOS</translation>
<translation id="2210682093923538346">Επικίνδυνος ιστότοπος. Το ${ product_display_name } κατάργησε ειδοποιήσεις.</translation>
<translation id="2236949375853147973">Η δραστηριότητά μου</translation>
<translation id="2238130810669087193">Για να έχετε πρόσβαση στις διευθύνσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο ${ product_display_name }. Αυτή η διεύθυνση θα αποθηκευτεί στον Λογαριασμό σας Google μετά τη σύνδεσή σας.</translation>
<translation id="2241627712206172106">Αν χρησιμοποιείτε έναν υπολογιστή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το ${ product_display_name } ακριβώς όπως θέλουν.</translation>
<translation id="2283803047247799269">Αναζήτηση σε αυτή την καρτέλα με την Αναζήτηση με εικόνες</translation>
<translation id="2287771843518581140">{NUM_TABS,plural, =1{Το ${ product_display_name } συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το ${ product_display_name } συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="2307973900865360088">Διατήρηση στο Dock</translation>
<translation id="2313870531055795960">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο ${ product_display_name }. Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το ${ product_display_name } μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση.</translation>
<translation id="2332076562712130931">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS" />
           • Θα επαναφέρει ορισμένες ρυθμίσεις και συντομεύσεις του ${ product_display_name }
           <ph name="LINE_BREAK" />
           • Θα απενεργοποιήσει τις επεκτάσεις
           <ph name="LINE_BREAK" />
           • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAKS" />
           Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="2343156876103232566">Για να στείλετε από εδώ έναν αριθμό στο τηλέφωνό σας Android, συνδεθείτε στο ${ product_display_name } και στις δύο συσκευές.</translation>
<translation id="2356070529366658676">Να γίνεται ερώτηση</translation>
<translation id="2359808026110333948">Συνέχεια</translation>
<translation id="2361918034042471035">Η επέκταση <ph name="EXTENSION_NAME" /> θέλει να συνδεθείτε στο ${ product_display_name }</translation>
<translation id="236943522426971115">Απενεργοποίηση του ${ product_display_name }, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="2374216753258219393">Για να χρησιμοποιήσετε αυτή την επέκταση με τον λογαριασμό <ph name="USER_EMAIL_ADDRESS" />, συνδεθείτε στο ${ product_display_name }.</translation>
<translation id="2384373936468275798">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το ${ product_display_name } OS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα.</translation>
<translation id="2398377054246527950">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις ${ product_display_name }}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις ${ product_display_name }}other{Αποκτήθηκε πρόσβαση σε # συσκευές HID από μία ή περισσότερες επεκτάσεις ${ product_display_name }}}</translation>
<translation id="2401032172288869980">Το ${ product_display_name } χρειάζεται άδεια μικροφώνου και κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="2403703063067034158">Σφάλμα εκκίνησης: Αυτή τη στιγμή εκτελείται μια άλλη παρουσία της ρύθμισης. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="2440750600860946460">Με τα <ph name="BEGIN_LINK" />εργαλεία του ${ product_display_name }<ph name="END_LINK" />, μπορείτε να περιηγείστε με ασφάλεια και να διατηρείτε τον έλεγχο</translation>
<translation id="2451727308784734061">Χρησιμοποιήστε τη συντόμευση για να μεταβείτε γρήγορα στον Διαχειριστή κωδικών πρόσβασης. Μπορείτε να μετακινήσετε τη συντόμευση στην αρχική οθόνη ή στην εφαρμογή εκκίνησης του υπολογιστή.</translation>
<translation id="2478295928299953161">Το ${ product_display_name } θα κλείσει σύντομα</translation>
<translation id="2483889755041906834">Στο ${ product_display_name }</translation>
<translation id="2485422356828889247">Απεγκατάσταση</translation>
<translation id="2513154137948333830">Απαιτείται επανεκκίνηση: <ph name="INSTALL_SUCCESS" /></translation>
<translation id="2542968102051442371">Επιλογή κειμένου με την Αναζήτηση με εικόνες</translation>
<translation id="2554739539410784893">Το ${ product_display_name } προσπαθεί να αντικαταστήσει τους υπάρχοντες κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="2560420686485554789">Το ${ product_display_name } χρειάζεται πρόσβαση στον αποθηκευτικό χώρο για τη λήψη αρχείων</translation>
<translation id="2572494885440352020">Πρόγραμμα βοήθειας ${ product_display_name }</translation>
<translation id="2575822587468774919">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="2576118232315942160">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο ${ product_display_name }</translation>
<translation id="2592940277904433508">Συνέχεια χρήσης του ${ product_display_name }</translation>
<translation id="259935314519650377">Απέτυχε η αποθήκευση του ληφθέντος προγράμματος εγκατάστασης στην κρυφή μνήμη. Σφάλμα: <ph name="UNPACK_CACHING_ERROR_CODE" />.</translation>
<translation id="2620436844016719705">Σύστημα</translation>
<translation id="2629740064077610681">Ο οργανισμός σας μπορεί να βλέπει και να διαχειρίζεται τα δεδομένα περιήγησης, όπως σελιδοδείκτες, ιστορικό και κωδικούς πρόσβασης. Δεν μπορεί να βλέπει τα δεδομένα περιήγησης σε άλλα προφίλ στο ${ product_display_name }</translation>
<translation id="2635452620547538388">Επαληθεύστε την ταυτότητά σας, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα ${ product_display_name } στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="2637732208198500597">{COUNT,plural, =0{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το ${ product_display_name }, προκειμένου να εφαρμοστεί μια ενημέρωση}=1{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το ${ product_display_name }, προκειμένου να εφαρμοστεί μια ενημέρωση. Το παράθυρο για ανώνυμη περιήγηση δεν θα ανοίξει ξανά.}other{Η Ενισχυμένη προστασία απαιτεί να επανεκκινήσετε το ${ product_display_name }, προκειμένου να εφαρμοστεί μια ενημέρωση. Τα # παράθυρα για ανώνυμη περιήγηση δεν θα ανοίξουν ξανά.}}</translation>
<translation id="2648074677641340862">Παρουσιάστηκε σφάλμα στο λειτουργικό σύστημα κατά την εγκατάσταση. Κατεβάστε το ${ product_display_name } ξανά.</translation>
<translation id="2661879430930417727">Εάν χρησιμοποιείτε μια συσκευή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το ${ product_display_name } ακριβώς όπως θέλουν.</translation>
<translation id="2711502716910134313">Καρτέλα ${ product_display_name }</translation>
<translation id="2718390899429598676">Για επιπλέον ασφάλεια, το ${ product_display_name } θα κρυπτογραφήσει τα δεδομένα σας.</translation>
<translation id="2721354645805494590">Για να καταργήσετε τον Λογαριασμό σας Google από το ${ product_display_name }, αποσυνδεθείτε</translation>
<translation id="2722636413143664436">Για να έχετε πρόσβαση στους κωδικούς πρόσβασης, στους σελιδοδείκτες και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο ${ product_display_name }</translation>
<translation id="2738871930057338499">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 403 Forbidden. Ελέγξτε τη διαμόρφωση των παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="2753623023919742414">Κάντε κλικ για αναζήτηση</translation>
<translation id="2768103863314748511">Ορισμός του ${ product_display_name } ως προεπιλεγμένου προγράμματος προβολής PDF</translation>
<translation id="277828055419948999">Το ${ product_display_name } μπορεί να συμπληρώνει αυτόματα δύσκολα πεδία που η βασική αυτόματη συμπλήρωση μπορεί να παραλείπει</translation>
<translation id="2785438272836277133">Αυτή η επέκταση περιέχει κακόβουλο πρόγραμμα και δεν είναι ασφαλής. Καταργήστε την από το ${ product_display_name }, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
