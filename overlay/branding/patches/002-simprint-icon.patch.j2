diff --git a/chrome/app/theme/{{ branding_path_component }}/BRANDING b/chrome/app/theme/{{ branding_path_component }}/BRANDING
new file mode 100644
--- /dev/null
+++ b/chrome/app/theme/{{ branding_path_component }}/BRANDING
@@ -0,0 +1,10 @@
+COMPANY_FULLNAME={{ product_display_name }}
+COMPANY_SHORTNAME={{ product_display_name }}
+PRODUCT_FULLNAME={{ product_display_name }}
+PRODUCT_SHORTNAME={{ product_display_name }}
+PRODUCT_INSTALLER_FULLNAME={{ product_display_name }} Installer
+PRODUCT_INSTALLER_SHORTNAME={{ product_display_name }} Installer
+COPYRIGHT=Copyright @LASTCHANGE_YEAR@ {{ product_display_name }}. All rights reserved.
+MAC_BUNDLE_ID=org.{{ branding_path_component }}.{{ product_display_name }}
+MAC_CREATOR_CODE=Simp
+MAC_TEAM_ID=
diff --git a/chrome/app/theme/{{ branding_path_component }}/win/README b/chrome/app/theme/{{ branding_path_component }}/win/README
new file mode 100644
--- /dev/null
+++ b/chrome/app/theme/{{ branding_path_component }}/win/README
@@ -0,0 +1,8 @@
+Place {{ product_display_name }} Windows icons here. Required when is_simprint_branded = true.
+
+  {{ branding_path_component }}.ico     - Main app icon (required)
+  app_list.ico     - App list
+  incognito.ico    - Incognito
+  {{ branding_path_component }}_doc.ico - HTML document
+  {{ branding_path_component }}_pdf.ico - PDF document
+
+For a quick test, copy from chromium: e.g. cp ../chromium/win/chromium.ico {{ branding_path_component }}.ico (and similarly for others).
