+std::vector<GURL> ParseUrlList(const base::Value::List* values,
+                               std::string_view source) {
+  std::vector<GURL> urls;
+  if (!values) {
+    return urls;
+  }
+
+  for (const auto& value : *values) {
+    if (!value.is_string()) {
+      continue;
+    }
+
+    GURL url(value.GetString());
+    if (!url.is_valid()) {
+      SIMPRINT_LOG(source << ": 无效的 URL: " << value.GetString());
+      continue;
+    }
+
+    if (std::find(urls.begin(), urls.end(), url) != urls.end()) {
+      continue;
+    }
+
+    urls.push_back(url);
+  }
+
+  return urls;
+}
