+
+        // Simprint: 配置加载成功后，检查是否需要打开 chrome://review 标签页
+        if (!profiles.empty()) {
+          Profile* profile = profiles[0];  // 使用第一个 profile
+
+          // 检查所有浏览器窗口是否已经有 chrome://review 标签页
+          bool review_tab_found = false;
+          const GURL review_url("chrome://review/");
+
+          for (Browser* browser : *BrowserList::GetInstance()) {
+            if (browser->profile() != profile) {
+              continue;
+            }
+
+            TabStripModel* tab_strip = browser->tab_strip_model();
+            for (int i = 0; i < tab_strip->count(); ++i) {
+              content::WebContents* web_contents = tab_strip->GetWebContentsAt(i);
+              if (web_contents) {
+                const GURL& url = web_contents->GetLastCommittedURL();
+                if (url.SchemeIs(content::kChromeUIScheme) && url.host() == "review") {
+                  review_tab_found = true;
+                  break;
+                }
+              }
+            }
+
+            if (review_tab_found) {
+              break;
+            }
+          }
+
+          // 如果没有找到 review 标签页，打开一个新的
+          if (!review_tab_found) {
+            Browser* browser = chrome::FindTabbedBrowser(profile, false);
+            if (browser) {
+              SIMPRINT_LOG("FingerprintApply: 自动打开 chrome://review 标签页");
+              chrome::AddTabAt(browser, review_url, -1, true);
+            }
+          } else {
+            SIMPRINT_LOG("FingerprintApply: chrome://review 标签页已存在，跳过打开");
+          }
+        }
