import("//tools/grit/grit_rule.gni")
import("//ui/webui/resources/tools/build_webui.gni")

# Main WebUI resources
build_webui("resources") {
  grd_prefix = "review"

  static_files = [ "review.html" ]

  ts_files = [
    "review.ts",
    "review_ui.ts",
  ]

  mojo_files_deps = [
    "//chrome/browser/ui/webui/review:mojo_bindings_ts__generator",
  ]

  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/review/review_page.mojom-webui.ts" ]

  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]

  webui_context_type = "trusted"
}
